# --- MasterHand ---
# Copy this file to deploy/.env and fill in the values.
# The real .env is NEVER committed.

# UI access password (stored hashed in the session cookie; the browser never sees this env)
MASTERHAND_PASSWORD=

# Secret used to sign session cookies and device tokens. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Session/token lifetime (hours) and the cookie Secure flag
SESSION_TTL_HOURS=720
COOKIE_SECURE=true

# Extra origins allowed on mutating requests (comma-separated). Only needed when a
# separate origin proxies to the BFF (for example a Vite dev server).
ALLOWED_ORIGINS=

# Host port/bind address for the BFF. Bind to 127.0.0.1 when your TLS proxy runs on the host.
MASTERHAND_BIND=0.0.0.0
MASTERHAND_PORT=8787

# Host directory mounted into opencode as /workspace. Every workspace you add from
# the UI is created as a subfolder inside it (isolated from the others).
WORKSPACES_DIR=../workspace

# --- opencode (internal) ---
# opencode server password; only the BFF knows it
OPENCODE_SERVER_PASSWORD=
OPENCODE_SERVER_USERNAME=opencode

# opencode version installed in the image (pin it in production)
OPENCODE_VERSION=1.18.32
